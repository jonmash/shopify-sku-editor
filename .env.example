# Copy this file to ".env" (same folder) and fill in your real values.
# Get these from Shopify: Settings > Apps and sales channels > Develop apps
# > Build apps in Dev Dashboard > your app > Credentials.
#
# SHOPIFY_SHOP_DOMAIN is your store's *.myshopify.com domain — find it at
# Settings > Domains in your Shopify admin, or in the browser URL bar:
# https://admin.shopify.com/store/<this-part>  ->  <this-part>.myshopify.com

SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=paste-client-id-here
SHOPIFY_CLIENT_SECRET=paste-client-secret-here
